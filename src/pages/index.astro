---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import {getPosts} from '../lib/posts';
const posts = await getPosts();
---
<Base><section class="intro"><div class="eyebrow"><span class="status-dot"></span> 赚钱 · SEO · 认知 · 生活</div><h1>赚点小钱，认真生活<span class="accent">。</span></h1><p>研究 SEO，探索赚钱的方法，<br />记录实践中的收获，也写认知与生活。</p><a class="text-link" href="/about/">你好，我是 Leon <span>→</span></a></section><section><div class="section-heading"><h2>最近的文字 <span>{String(posts.length).padStart(2,'0')}</span></h2><a href="/tags/">浏览标签 ↗</a></div>{posts.length ? <PostList posts={posts} /> : <p class="empty-state">还没有写下第一篇。关于赚钱、SEO、认知与生活的记录，会从这里开始。</p>}</section><aside class="note"><span>✳</span><p>边做边学，慢慢积累。<small>把尝试和思考写下来，留给下一次出发。</small></p><a href="/rss.xml" aria-label="通过 RSS 订阅">订阅 RSS ↗</a></aside></Base>
