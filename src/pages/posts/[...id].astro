---
import ReadCount from '../../components/ReadCount.astro';
import {render} from 'astro:content';
import Base from '../../layouts/Base.astro';
import {getPosts,dateLabel} from '../../lib/posts';
export async function getStaticPaths(){ return (await getPosts()).map(post=>({params:{id:post.id},props:{post}})); }
const {post}=Astro.props; const {Content,headings}=await render(post);
---
<Base title={post.data.title} description={post.data.description}><article><div class="page-heading article-heading"><a class="text-link" href="/">← 返回文章</a><div class="article-meta"><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><span> / </span>{post.data.tags.join(' · ')}<span> / </span><ReadCount slug={post.id} increment /></div><h1>{post.data.title}</h1><p>{post.data.description}</p></div>{headings.length>0&&<details class="toc"><summary>文章目录</summary><ul>{headings.filter(h=>h.depth===2).map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></details>}<div class="prose"><Content /></div><div class="article-end"><span>— 感谢阅读 —</span><a href="/">继续阅读其他文章 →</a></div></article></Base>
