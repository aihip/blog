---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import {getPosts} from '../lib/posts';
const posts = await getPosts();
const years = [...new Set(posts.map(p => p.data.date.getUTCFullYear()))];
---
<Base title="归档"><section class="page-heading"><div class="eyebrow">THE ARCHIVE</div><h1>文字归档<span class="accent">.</span></h1><p>共 {posts.length} 篇文章，一点一滴积累。</p></section>{posts.length === 0 && <p class="empty-state">这里会收好往后的每一篇文字。</p>}{years.map(year=><section><div class="section-heading"><h2>{year}</h2></div><PostList posts={posts.filter(p=>p.data.date.getUTCFullYear()===year)} /></section>)}</Base>
