---
import '../styles/global.css';
import { Image, getImage } from 'astro:assets';
import avatar from '../assets/leon-laozi-avatar.png';
interface Props { title?: string; description?: string; }
const { title, description = 'Leon 的个人博客，记录赚钱与 SEO 的探索、赚点小钱的尝试，以及关于认知与生活的思考。' } = Astro.props;
const pageTitle = title ? `${title} · Leon` : 'Leon · 赚钱与生活';
const pathname = Astro.url.pathname;
const favicon = await getImage({ src: avatar, width: 48, height: 48, format: 'png' });
const touchIcon = await getImage({ src: avatar, width: 180, height: 180, format: 'png' });
---
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
<title>{pageTitle}</title><meta name="description" content={description} />
<link rel="canonical" href={new URL(pathname, Astro.site)} />
<meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content={new URL(pathname, Astro.site)} />
<meta name="color-scheme" content="light dark" /><link rel="icon" href={favicon.src} type="image/png" sizes="48x48" />
<link rel="apple-touch-icon" href={touchIcon.src} sizes="180x180" />
<link rel="alternate" type="application/rss+xml" title="Leon RSS" href="/rss.xml" />
<script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}catch{}</script>
</head>
<body>
<a class="skip" href="#main">跳到正文</a>
<div class="shell">
<header><a class="brand" href="/" aria-label="Leon 首页"><Image class="brand-avatar" src={avatar} alt="" width={88} height={88} format="webp" quality={85} loading="eager" /><span>Leon<span class="brand-slash"> / </span>blog</span></a><nav aria-label="主导航">{[['/', '文章'], ['/archives/', '归档'], ['/about/', '关于']].map(([url, label]) => <a href={url} aria-current={pathname === url ? 'page' : undefined}>{label}</a>)}<button id="theme-toggle" aria-label="切换深色模式" title="切换配色">◐</button></nav></header>
<main id="main"><slot /></main>
<footer><span>© {new Date().getFullYear()} Leon <span class="footer-dot">·</span> 赚点小钱，认真生活。</span><div><a href="/rss.xml">RSS ↗</a><a href="/about/">关于这里 ↗</a></div></footer>
</div>
<script>
const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
const updateLabel = () => button?.setAttribute('aria-label', document.documentElement.dataset.theme === 'dark' ? '切换浅色模式' : '切换深色模式');
updateLabel();
button?.addEventListener('click', () => { const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; document.documentElement.dataset.theme = next; try { localStorage.setItem('theme', next); } catch {} updateLabel(); });
</script>
</body></html>
