---
import type { CollectionEntry } from 'astro:content';
import ReadCount from './ReadCount.astro';
import { dateLabel } from '../lib/posts';
interface Props { posts: CollectionEntry<'posts'>[] }
const {posts} = Astro.props;
---
<div class="post-list">{posts.map(post => <article class="post-row"><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><div><a class="post-title" href={`/posts/${post.id}/`}>{post.data.title}<span aria-hidden="true">↗</span></a><p>{post.data.description}</p><div class="post-tags">{post.data.tags.map(tag=><a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}</div><ReadCount slug={post.id} /></div></article>)}</div>
